[
 {
  "f": "ElevenLabs_2026-10-17T21_00_49_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "Meera? Meera? Where are you?"
 },
 {
  "f": "ElevenLabs_2026-10-17T21_01_22_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "Stay away from me. Why won't it hurt me?"
 },
 {
  "f": "ElevenLabs_2026-10-17T21_01_42_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "I promised."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_01_54_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "There are so many. I can't go back."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_02_18_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "That voice. No, it can't be."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_02_31_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "The forest. She said the lantern always knows the way to the tower."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_02_45_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "You followed me. You always follow me!"
 },
 {
  "f": "ElevenLabs_2026-10-17T21_02_57_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "Mita? Is it really you?"
 },
 {
  "f": "ElevenLabs_2026-10-17T21_03_22_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "They look like they're made of my own shadow."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_03_35_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "I dropped it. It was me. It was always me."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_03_48_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "It was an accident."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_04_02_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "The tower. The clock stopped at one minute to midnight, the minute I dropped it."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_04_29_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "If I turn the clock back, maybe none of it ever happened."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_04_43_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "It's watching me. It has been watching all night."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_04_56_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "It's quiet now. The clock is still stuck."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_05_35_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "Hup. Hup."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_05_44_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "Ha! Ha!"
 },
 {
  "f": "ElevenLabs_2026-10-17T21_05_54_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "Huh. Huh."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_06_03_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "Ugh, ugh."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_06_12_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "Ugh, ugh."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_06_23_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "Ahh! Ahh!"
 },
 {
  "f": "ElevenLabs_2026-10-17T21_06_56_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "Mira..."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_07_07_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "Sigh"
 },
 {
  "f": "ElevenLabs_2026-10-17T21_07_17_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "Ha!"
 },
 {
  "f": "ElevenLabs_2026-10-17T21_07_28_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "Hah!"
 },
 {
  "f": "ElevenLabs_2026-10-17T21_09_43_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "C-C-C-C-C-C..."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_10_09_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "Hyah! Up!"
 },
 {
  "f": "ElevenLabs_2026-10-17T21_10_21_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "Ah, okay."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_10_34_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "Oh, it's warm!"
 },
 {
  "f": "ElevenLabs_2026-10-17T21_10_46_Quang Anh - Bright, Brilliant_pvc_sp111_s89_sb100_v4.mp3",
  "t": "Ugh! Go back!"
 },
 {
  "f": "ElevenLabs_2026-10-17T21_12_20_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "The village is burning. The Great Bell has stopped."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_12_57_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "The lantern is warm in his hands. Something tall and dark rises out of his shadow."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_13_14_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "an ember beast. Shoot it with the lantern, Jay. Hold Jay to charge a stronger flare."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_13_31_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "A burning enemy glows cyan for a moment. Press P and Mira's shadow strike finishes it."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_13_47_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "The path is broken. The burning gap is far too wide to jump."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_14_02_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "Shoot the cracked tree 3 times, Jay. It will fall across the gap and become your path."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_14_19_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "A memory. Mira kneels, closing his small hands around the lantern."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_14_35_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "Ember beasts crawl out of the ash of the square."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_14_49_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "Behind him, the shadow lowers one long hand between the boy and the flames."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_15_24_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "The dark forest, the fire never reached it, only the shadows did."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_15_42_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "The shadow does not answer. The fireflies drift closer."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_15_58_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "Hollow shapes rise out of the black earth."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_16_16_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "Another memory dry cloth in the storeroom the lantern slipping from his fingers"
 },
 {
  "f": "ElevenLabs_2026-10-17T21_16_34_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "The flame spreading faster than he could scream."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_17_05_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "The black water is too wide, even for a double jump."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_17_23_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "Shoot the cracked dead tree 3 times, Jay. It will fall and become your bridge."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_17_41_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "In the clearing, something old is waiting. A blade made for endings."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_17_59_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "The Clock Tower. Every gear inside is frozen at 11.59."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_18_18_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "The tower lends him a little of its power. Hold Q and the last moments run backwards."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_18_48_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "The tower's crushers slam on the beat of the clock."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_19_05_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "Wait for the red glow to fade as it rises, then run under it. Caught? Hold Q to rewind."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_19_24_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "At the top of the tower, the clockwork opens one great eye."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_19_41_Jon - Warm & Grounded Storyteller_pvc_sp95_s85_sb88_v4.mp3",
  "t": "Far below something heavy and horned begins to climb"
 },
 {
  "f": "ElevenLabs_2026-10-17T21_21_05_Elise - Warm, Natural and Engaging_pvc_sp100_s50_sb75_v4.mp3",
  "t": "If the bell ever stops, carry the light to the clock tower. Promise me."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_21_20_Elise - Warm, Natural and Engaging_pvc_sp100_s50_sb75_v4.mp3",
  "t": "Light them up, little brother. I'll do the rest."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_21_32_Elise - Warm, Natural and Engaging_pvc_sp100_s50_sb75_v4.mp3",
  "t": "Someone has to keep you out of trouble."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_21_45_Elise - Warm, Natural and Engaging_pvc_sp100_s50_sb75_v4.mp3",
  "t": "Fire shows them. I finish them. Together, Ilion."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_21_57_Elise - Warm, Natural and Engaging_pvc_sp100_s50_sb75_v4.mp3",
  "t": "I know. I came back for you anyway."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_22_29_Elise - Warm, Natural and Engaging_pvc_sp100_s50_sb75_v4.mp3",
  "t": "Don't listen to it. Stay behind me, Ilyan. Not this time."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_22_43_Elise - Warm, Natural and Engaging_pvc_sp100_s50_sb75_v4.mp3",
  "t": "Then let's go and see what is waiting at the top."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_22_58_Elise - Warm, Natural and Engaging_pvc_sp100_s50_sb75_v4.mp3",
  "t": "Time doesn't forgive Ilyan, but it remembers."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_23_12_Elise - Warm, Natural and Engaging_pvc_sp100_s50_sb75_v4.mp3",
  "t": "Then, we will give it something new to watch."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_23_25_Elise - Warm, Natural and Engaging_pvc_sp100_s50_sb75_v4.mp3",
  "t": "Not for long. One last door, Ilyan. I'm right here."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_24_00_Elise - Warm, Natural and Engaging_pvc_sp100_s50_sb75_v4.mp3",
  "t": "You dropped the lantern, boy. You remember. You always remember."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_25_19_Adam - American, Dark and Tough_pvc_sp100_s50_sb75_v4.mp3",
  "t": "Tell that to the fire."
 },
 {
  "f": "ElevenLabs_2026-10-17T21_25_51_Adam - American, Dark and Tough_pvc_sp100_s50_sb75_v4.mp3",
  "t": "Every second you replay every second you regret"
 }
]