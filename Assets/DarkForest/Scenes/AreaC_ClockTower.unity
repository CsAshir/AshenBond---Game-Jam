  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  lines:
  - '|The Clock Tower. Every gear inside is frozen at 11:59.'
  - Ilyan|If I turn the clock back... maybe none of it ever happened.
  - Mira|Time doesn't forgive, Ilyan. But it remembers.
  - '|The tower lends him a little of its power. Hold Q, and the last moments run
    backwards.'
  playOnStart: 0
  focus: {fileID: 0}
  startDelay: 0.8
